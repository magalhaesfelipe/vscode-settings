{
  "update.mode": "none",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "workbench.startupEditor": "none",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "notebook.defaultFormatter": "esbenp.prettier-vscode",
  "explorer.confirmDelete": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "explorer.confirmDragAndDrop": false,

  "explorer.confirmPasteNative": false,
  "window.menuBarVisibility": "toggle",

  "workbench.colorCustomizations": {
    "terminal.ansiMagenta": "#dc5a8c",
    "terminal.ansiGreen": "#4ab888"
  },

  "terminal.integrated.tabs.defaultColor": "terminal.ansiGreen",
  "terminal.integrated.tabs.defaultIcon": "terminal-tmux",
  "task.allowAutomaticTasks": "on",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "terminal.integrated.copyOnSelection": true,

  "github.copilot.enable": {
    "*": false
  },

  "workbench.settings.applyToAllProfiles": ["terminal.integrated.suggest.enabled"],

  "settingsSync.ignoredExtensions": ["iwyvi.chinolor"],

  "terminal.integrated.env.windows": {},
  "console-ninja.featureSet": "Community",

  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "turboConsoleLog.delimiterInsideMessage": "-",
  "turboConsoleLog.logMessagePrefix": "🐟",
  "window.newWindowDimensions": "maximized",
  "window.confirmSaveUntitledWorkspace": false,
  "diffEditor.renderSideBySide": false,
  "git.openRepositoryInParentFolders": "never",

  // Better todo tree
  "better-todo-tree.highlights.customHighlight": {
    "TODO": {
      "foreground": "#ffffff",
      "background": "#06a5b1",
      "type": "text"
    },
    "FIXME": {
      "foreground": "#000000",
      "background": "#f3c600",
      "type": "text"
    }
  },
  "better-todo-tree.general.tags": ["BUG", "HACK", "FIXME", "TODO", "XXX", "[ ]", "[x]"],
  "better-todo-tree.regex.regexCaseSensitive": false,
  "editor.detectIndentation": false,
  "editor.tabSize": 2,
  "chat.mcp.autostart": "never",
  "chat.mcp.serverSampling": {},
  "accessibility.verbosity.inlineChat": false,

  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "ms-settings"
  ],

  "prettier.printWidth": 100,
  "editor.minimap.showSlider": "always",
  "editor.minimap.autohide": "mouseover",
  "editor.minimap.maxColumn": 115,
  "editor.lineHeight": 1.5,
  "editor.fontFamily": "Fira Code",
  "editor.fontLigatures": true,
  "debug.console.lineHeight": 1.5,
  "terminal.integrated.lineHeight": 1.2,
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "window.border": "off",
  "window.commandCenter": false,
  "editor.minimap.side": "left",
  "workbench.sideBar.location": "right",
  "terminal.integrated.tabs.location": "left",
  "terminal.integrated.suggest.enabled": false,

  "security.workspace.trust.banner": "never",
  "security.workspace.trust.startupPrompt": "never",
  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.enabled": false,

  "terminal.integrated.initialHint": false,
  "editor.minimap.scale": 2,

  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.pdf": "default",
    "*.md": "default"
  },
  "extensions.ignoreRecommendations": true,
  "editor.wordWrapColumn": 110,
  "editor.formatOnSave": true,
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.editor.empty.hint": "hidden",
  "workbench.statusBar.visible": false,
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]* archival)[\"'`]"],
    ["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "tailwindCSS.includeLanguages": {
    "typescript": "javascriptreact",
    "typescriptreact": "javascriptreact"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "files.autoSaveWorkspaceFilesOnly": true,
  "editor.cursorStyle": "block",
  // "background.fullscreen": {
  //   "images": [
  //     // "file:///C:/tree/images/wallpaper-bank/photography/Japan/urban/day/pink_flags_white_trees2.jpg",
  //   ],
  //   "opacity": 0.096,
  //   "size": "cover",
  //   "position": "center",
  // },
  "js/ts.preferences.importModuleSpecifier": "relative",
  "accessibility.verboseChatProgressUpdates": false,
  "terminal.integrated.enablePersistentSessions": false,
  "chat.viewSessions.orientation": "stacked",
  "files.exclude": {
    "**/.git": false
  },
  "workbench.iconTheme": "file-icons",
  "material-icon-theme.folders.theme": "none",
  "editor.tabCompletion": "onlySnippets",
  "workbench.productIconTheme": "icons-carbon",
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "editor.lineNumbers": "interval",
  "workbench.activityBar.location": "hidden",

  // Code Spell:
  "cSpell.language": "en,en_GB,pt,pt_BR",
  "cSpell.enabledFileTypes": {
    "*": false,
    "javascript": true,
    "javascriptreact": true,
    "typescript": true,
    "typescriptreact": true,
    "markdown": true,
    "plaintext": true
  },
  "cSpell.ignoreRegExpList": ["/(?:from\\s+|import\\s+)[\"'][^\"']+[\"']/g"],
  "workbench.colorTheme": "Toge 2"
}
